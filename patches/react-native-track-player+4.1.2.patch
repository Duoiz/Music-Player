+    @ReactMethod
+    fun setEqualizerBands(bands: ReadableArray, promise: Promise) { scope.launch {
+        try {
+            val doubleArray = DoubleArray(bands.size()) { i -> bands.getDouble(i) }
+            cachedBands = doubleArray
+            Log.i("RNTP_EQ", "setEqualizerBands: ${doubleArray.contentToString()}")
+
+            val eq = obtainEqualizer()
+            if (eq != null) {
+                val range = eq.bandLevelRange
+                val minLevel = range?.get(0)?.toInt() ?: -1500
+                val maxLevel = range?.get(1)?.toInt() ?: 1500
+                val numBands = eq.numberOfBands.toInt()
+                for (i in 0 until Math.min(numBands, doubleArray.size)) {
+                    val millibels = (doubleArray[i] * 100.0).toInt().coerceIn(minLevel, maxLevel).toShort()
+                    try {
+                        eq.setBandLevel(i.toShort(), millibels)
+                    } catch (e: Exception) {
+                        Log.w("RNTP_EQ", "Failed to set band $i: ${e.message}")
+                    }
+                }
+            }
+            promise.resolve(true)
+        } catch (e: Exception) {
+            Log.e("RNTP_EQ", "setEqualizerBands error: ${e.message}")
+            promise.reject("EQ_ERROR", e.message)
+        }
+    } }
+
+    @ReactMethod
+    fun setEqualizerEnabled(enabled: Boolean, promise: Promise) { scope.launch {
+        try {
+            isEqEnabled = enabled
+            Log.i("RNTP_EQ", "setEqualizerEnabled: $enabled")
+            val eq = obtainEqualizer()
+            if (eq != null) {
+                eq.enabled = enabled
+                Log.i("RNTP_EQ", "Equalizer.enabled set to $enabled on session $currentSessionId")
+            }
+            try {
+                loudnessEnhancer?.setTargetGain(eqGainCompensationMb)
+                loudnessEnhancer?.enabled = enabled
+                Log.i("RNTP_EQ", "LoudnessEnhancer.enabled set to $enabled on session $currentSessionId")
+            } catch (e: Exception) {
+                Log.w("RNTP_EQ", "LoudnessEnhancer update failed: ${e.message}")
+            }
+            promise.resolve(true)
+        } catch (e: Exception) {
+            Log.e("RNTP_EQ", "setEqualizerEnabled error: ${e.message}")
+            promise.reject("EQ_ERROR", e.message)
+        }
+    } }
