+    private var equalizer: Equalizer? = null
+    private var loudnessEnhancer: LoudnessEnhancer? = null
+    private var currentSessionId: Int = 0
+    private var isEqEnabled: Boolean = false
+    private var cachedBands: DoubleArray? = null
+    private var eqGainCompensationMb: Int = 350 // +3.5 dB compensation for Android EQ headroom attenuation
+
+    private fun obtainEqualizer(): Equalizer? {
+        if (!isServiceBound) {
+            Log.d("RNTP_EQ", "obtainEqualizer: service not bound yet")
+            return equalizer
+        }
+
+        val sessionId = musicService.getAudioSessionId()
+        Log.i("RNTP_EQ", "obtainEqualizer: audioSessionId=$sessionId, currentSessionId=$currentSessionId")
+
+        if (sessionId == 0) {
+            Log.w("RNTP_EQ", "audioSessionId is 0, player may not be actively playing yet")
+            return equalizer
+        }
+
+        if (equalizer != null && currentSessionId == sessionId) {
+            return equalizer
+        }
+
+        // Session ID changed or new equalizer needed — release old one
+        try {
+            if (currentSessionId != 0) {
+                val closeIntent = Intent(AudioEffect.ACTION_CLOSE_AUDIO_EFFECT_CONTROL_SESSION).apply {
+                    putExtra(AudioEffect.EXTRA_AUDIO_SESSION, currentSessionId)
+                    putExtra(AudioEffect.EXTRA_PACKAGE_NAME, context.packageName)
+                }
+                context.sendBroadcast(closeIntent)
+            }
+            equalizer?.release()
+            loudnessEnhancer?.release()
+            equalizer = null
+            loudnessEnhancer = null
+            Log.i("RNTP_EQ", "Released previous equalizer and loudnessEnhancer for session $currentSessionId")
+        } catch (e: Exception) {
+            Log.w("RNTP_EQ", "Error releasing old equalizer/enhancer: ${e.message}")
+        }
+
+        return try {
+            // Priority 0 is standard priority and required by Samsung & standard HALs
+            val newEq = Equalizer(0, sessionId)
+            currentSessionId = sessionId
+
+            // Broadcast open audio effect session to notify Bluetooth & audio routing stack
+            val openIntent = Intent(AudioEffect.ACTION_OPEN_AUDIO_EFFECT_CONTROL_SESSION).apply {
+                putExtra(AudioEffect.EXTRA_AUDIO_SESSION, sessionId)
+                putExtra(AudioEffect.EXTRA_PACKAGE_NAME, context.packageName)
+            }
+            context.sendBroadcast(openIntent)
+
+            val range = newEq.bandLevelRange
+            val minLevel = range?.get(0)?.toInt() ?: -1500
+            val maxLevel = range?.get(1)?.toInt() ?: 1500
+            val numBands = newEq.numberOfBands.toInt()
+            Log.i("RNTP_EQ", "Created Equalizer on session $sessionId — bands=$numBands, range=[$minLevel, $maxLevel]")
+
+            // Apply cached bands before enabling
+            cachedBands?.let { bands ->
+                for (i in 0 until Math.min(numBands, bands.size)) {
+                    val millibels = (bands[i] * 100.0).toInt().coerceIn(minLevel, maxLevel).toShort()
+                    try {
+                        newEq.setBandLevel(i.toShort(), millibels)
+                        Log.d("RNTP_EQ", "Band[$i] set to $millibels mB (${bands[i]} dB)")
+                    } catch (e: Exception) {
+                        Log.w("RNTP_EQ", "Failed to set band $i: ${e.message}")
+                    }
+                }
+            }
+
+            newEq.enabled = isEqEnabled
+            Log.i("RNTP_EQ", "Equalizer enabled state set to $isEqEnabled")
+
+            // Initialize LoudnessEnhancer to offset Android's internal EQ headroom reduction
+            try {
+                val newEnhancer = LoudnessEnhancer(sessionId).apply {
+                    setTargetGain(eqGainCompensationMb)
+                    enabled = isEqEnabled
+                }
+                loudnessEnhancer = newEnhancer
+                Log.i("RNTP_EQ", "LoudnessEnhancer initialized on session $sessionId with +${eqGainCompensationMb}mB, enabled=$isEqEnabled")
+            } catch (e: Exception) {
+                Log.w("RNTP_EQ", "LoudnessEnhancer initialization warning: ${e.message}")
+            }
+
+            equalizer = newEq
+            newEq
+        } catch (e: Exception) {
+            Log.e("RNTP_EQ", "Failed to create Equalizer for session $sessionId: ${e.message}", e)
+            equalizer
+        }
+    }
